  <bpmn:process id="Process_InvolvedUsers" name="Involved Users" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:userTaskForm id="UserTaskForm_0en57i8">{
  "type": "checklist",
  "id": "Field_choice",
  "key": "choice",
  "label": "Select options",
  "values": [
    { "label": "oneUser", "value": "oneUser" },
    { "label": "candidateGroups", "value": "candidateGroups" },
    { "label": "candidateUsers", "value": "candidateUsers" },
    { "label": "noCandidates", "value": "noCandidates" },
    { "label": "iterate", "value": "iterate" },
    { "label": "groupButAssigned", "value": "groupButAssigned" },
  ]
}</zeebe:userTaskForm>
    </bpmn:extensionElements>
